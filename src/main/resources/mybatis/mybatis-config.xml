<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <settings>
        <!-- Enable caching of query results -->
        <setting name="cacheEnabled" value="true"/>

        <!-- Enable lazy loading for associated objects -->
        <setting name="lazyLoadingEnabled" value="true"/>

        <!-- Auto-retrieve generated keys -->
        <setting name="useGeneratedKeys" value="true"/>

        <!-- Auto convert underscore_case to camelCase -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>

        <!-- Convert NULL values to IS NULL in WHERE clause -->
        <setting name="jdbcTypeForNull" value="NULL"/>

        <!-- Use SLF4J for logging -->
        <setting name="logImpl" value="SLF4J"/>

        <!-- Log prefix -->
        <setting name="logPrefix" value="[MyBatis] "/>
    </settings>

    <!-- 
        Note: Mapper files are loaded by Spring's sqlSessionFactory.mapperLocations
        configuration in root-context.xml. The mapperLocations property uses the pattern:
        classpath:mybatis/mappers/**/*.xml
        
        All mapper XML files under mybatis/mappers directory are automatically loaded.
        Do not define mappers section here to avoid duplicate loading errors.
    -->

</configuration>