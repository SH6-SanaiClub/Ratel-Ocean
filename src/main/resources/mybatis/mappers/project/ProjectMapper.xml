<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
═══════════════════════════════════════════════════════════════════════
ProjectMapper.xml
═══════════════════════════════════════════════════════════════════════

[설명]
프로젝트 등록 및 관리를 위한 MyBatis Mapper XML 파일입니다.
projects 테이블과 project_stacks 테이블에 대한 SQL 쿼리를 정의합니다.

[위치]
경로: mybatis/mappers/project/ProjectMapper.xml
인터페이스: com.sanaiclub.domain.project.dao.ProjectMapper

[쿼리 목록]
1. insertProject: 프로젝트 기본 정보 삽입
   - useGeneratedKeys=true로 자동 생성된 project_id를 VO에 매핑
   
2. insertProjectStack: 프로젝트-스택 관계 삽입
   - project_stacks 테이블에 프로젝트와 스택의 관계 저장
   - 개발분야(POSITION) 1개와 기술스택(SKILL) 여러 개를 저장

@author 이은희 (신한DS 금융 SW 아카데미)
@version 1.0
@since 2026-01-18
-->

<mapper namespace="com.sanaiclub.domain.project.dao.ProjectMapper">

    <!-- 프로젝트 대시보드용 결과 매핑 -->
    <resultMap id="projectDashboardMap" type="com.sanaiclub.domain.project.dto.ProjectDashboardDTO">
        <id column="project_id" property="projectId" />
        <result column="title" property="title" />
        <result column="est_duration" property="estDuration" />
        <result column="budget" property="budget" />
        <result column="applicant_count" property="applicantCount" />
        <result column="dday" property="dday" />
        <collection property="stacks" ofType="com.sanaiclub.domain.project.dto.StackDto"
                    column="project_id" select="selectStacksByProjectId" />
    </resultMap>

    <!-- 프로젝트 상세 결과 매핑 (스택/첨부 포함) -->
    <resultMap id="projectDetailMap" type="com.sanaiclub.domain.project.dto.ProjectDetailDTO">
        <id column="project_id" property="projectId" />
        <result column="client_id" property="clientId" />
        <result column="title" property="title" />
        <result column="description" property="description" />
        <result column="start_date" property="startDate" />
        <result column="deadline_date" property="deadlineDate" />
        <result column="est_duration" property="estDuration" />
        <result column="duration_negotiable" property="durationNegotiable" />
        <result column="budget" property="budget" />
        <result column="budget_negotiable" property="budgetNegotiable" />
        <result column="communicate_method" property="communicateMethod" />
        <result column="payment_method" property="paymentMethod" />
        <result column="change_policy" property="changePolicy" />
        <result column="max_revision_count" property="maxRevisionCount" />
        <result column="project_status" property="projectStatus" />
        <result column="is_public" property="isPublic" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="view_count" property="viewCount" />
        <result column="applicant_count" property="applicantCount" />
        <result column="plan_url" property="planUrl" />
        <result column="file_size" property="fileSize" />
        <collection property="stacks" ofType="com.sanaiclub.domain.project.dto.StackDto"
                    column="project_id" select="selectStacksByProjectId" />
    </resultMap>

    <!-- ═══════════════════════════════════════════════════════════════
         [INSERT] 프로젝트 기본 정보 삽입
         
         [목적]
         - projects 테이블에 새로운 프로젝트를 등록합니다
         - MyBatis의 useGeneratedKeys 기능으로 자동 생성된 project_id를 반환받습니다
         
         [파라미터]
         - parameterType: com.sanaiclub.domain.project.vo.ProjectVO
         - 입력: ProjectService에서 생성한 ProjectVO 객체
         - 출력: projectId 필드에 자동 생성된 ID가 할당됨
         
         [useGeneratedKeys 설정]
         - useGeneratedKeys="true": INSERT 후 자동 생성된 키를 가져옵니다
         - keyProperty="projectId": 생성된 키를 projectId 필드에 매핑합니다
         - DB의 AUTO_INCREMENT로 생성된 project_id를 Java 객체로 전달합니다
         
         [삽입 컬럼 설명]
         1) client_id: 프로젝트 등록자 (FK → users.user_id)
         2) title: 프로젝트 제목 (VARCHAR(200), NOT NULL)
         3) description: 프로젝트 상세 설명 (TEXT, NOT NULL)
         4) start_date: 프로젝트 시작일 (DATE, NOT NULL)
         5) deadline_date: 지원 마감일 (DATE, NOT NULL)
         6) est_duration: 예상 진행 기간 (VARCHAR(50))
         7) duration_negotiable: 기간 협의 가능 여부 (BOOLEAN)
         8) budget: 프로젝트 예산 (INT)
         9) budget_negotiable: 예산 협의 가능 여부 (BOOLEAN)
         10) communicate_method: 소통 방식 (VARCHAR(20): ONLINE/OFFLINE)
         11) payment_method: 대금 지급 방식 (VARCHAR(20): LUMP_SUM/INSTALLMENT)
         12) max_revision_count: 최대 무료 수정 횟수 (INT, 0~3)
         13) change_policy: 수정 관련 상세 규정 (TEXT)
         14) project_status: 프로젝트 상태 (ENUM: READY, RECRUITING, 등)
         15) is_public: 공개 여부 (BOOLEAN, 기본값 TRUE)
         16) plan_url: 기획서 파일 경로 (VARCHAR(500), NULL 허용)
         17) file_size: 기획서 파일 크기 (VARCHAR(20), NULL 허용)
         
         [자동 생성 컬럼 (INSERT 시 생략)]
         - project_id: AUTO_INCREMENT (PK)
         - created_at: CURRENT_TIMESTAMP (생성 일시)
         - updated_at: CURRENT_TIMESTAMP ON UPDATE (수정 일시)
         - view_count: DEFAULT 0 (조회수)
         - applicant_count: DEFAULT 0 (지원자 수)
         
         [트랜잭션]
         - Service 계층의 @Transactional로 관리됨
         - project_stacks와 함께 원자성 보장
         ═══════════════════════════════════════════════════════════════ -->
    <insert id="insertProject" parameterType="com.sanaiclub.domain.project.vo.ProjectVO"
            useGeneratedKeys="true" keyProperty="projectId">
        INSERT INTO projects (
            client_id, 
            title, 
            description,
            start_date, 
            deadline_date,
            est_duration, 
            duration_negotiable,
            budget, 
            budget_negotiable,
            communicate_method, 
            payment_method,
            max_revision_count, 
            change_policy, 
            project_status, 
            is_public,
            plan_url, 
            file_size
        ) VALUES (
            #{clientId}, 
            #{title}, 
            #{description},
            #{startDate}, 
            #{deadlineDate},
            #{estDuration}, 
            #{durationNegotiable},
            #{budget}, 
            #{budgetNegotiable},
            #{communicateMethod}, 
            #{paymentMethod},
            #{maxRevisionCount}, 
            #{changePolicy}, 
            #{projectStatus}, 
            #{isPublic},
            #{planUrl}, 
            #{fileSize}
        )
    </insert>

    <!-- ═══════════════════════════════════════════════════════════════
         [INSERT] 프로젝트-스택 매핑 정보 삽입
         
         [목적]
         - project_stacks 테이블에 프로젝트와 기술 스택의 관계를 저장합니다
         - 한 프로젝트는 여러 개의 스택을 가질 수 있습니다 (1:N 관계)
         
         [파라미터]
         - parameterType: com.sanaiclub.domain.project.vo.ProjectStackVO
         - 각 스택마다 개별적으로 INSERT 수행됨 (Service에서 반복 호출)
         
         [삽입 컬럼 설명]
         1) project_id: 프로젝트 ID (FK → projects.project_id)
         2) stack_id: 스택 ID (FK → stacks.stack_id)
         3) stack_level: 요구 숙련도 (1~5, 1=초급, 5=전문가)
         4) stack_year: 요구 경력 (년 단위, 예: 1, 3, 5)
         
         [스택 종류]
         - POSITION 카테고리: 개발 영역 (웹, 모바일, 데이터 분석 등)
         - SKILL 카테고리: 기술 스택 (Java, React, Python 등)
         - 모달 방식: 사용자가 여러 스택을 선택하고 각각 레벨/경력 지정
         
         [예시 데이터]
         - project_id=1, stack_id=10 (웹 개발), level=3, year=2
         - project_id=1, stack_id=25 (Java), level=4, year=3
         - project_id=1, stack_id=30 (Spring), level=3, year=2
         
         [호출 방식]
         - ProjectService의 createProject 메서드에서:
           for (int i = 0; i < stackIds.size(); i++) {
               projectMapper.insertProjectStack(stackVO);
           }
         - 각 스택마다 별도의 INSERT 쿼리 실행
         
         [트랜잭션]
         - Service 계층의 @Transactional로 관리됨
         - 하나라도 실패하면 전체 롤백 (projects + project_stacks)
         ═══════════════════════════════════════════════════════════════ -->
    <insert id="insertProjectStack" parameterType="com.sanaiclub.domain.project.vo.ProjectStackVO">
        INSERT INTO project_stacks (
            project_id, 
            stack_id, 
            stack_level, 
            stack_year
        ) VALUES (
            #{projectId}, 
            #{stackId}, 
            #{stackLevel}, 
            #{stackYear}
        )
    </insert>

    <!-- 모든 공개 프로젝트 조회 (최신순) -->
    <select id="findAllProjects" resultMap="projectDashboardMap">
        SELECT 
            p.project_id,
            p.title,
            p.est_duration,
            p.budget,
            IFNULL(p.applicant_count, 0) AS applicant_count,
            DATEDIFF(p.deadline_date, CURRENT_DATE()) AS dday
        FROM projects p
        WHERE p.is_public = 1
        ORDER BY p.created_at DESC
    </select>

    <!-- 특정 클라이언트가 등록한 프로젝트 조회 -->
    <select id="findProjectsByClientId" parameterType="int" resultMap="projectDashboardMap">
        SELECT 
            p.project_id,
            p.title,
            p.est_duration,
            p.budget,
            IFNULL(p.applicant_count, 0) AS applicant_count,
            DATEDIFF(p.deadline_date, CURRENT_DATE()) AS dday
        FROM projects p
        WHERE p.client_id = #{clientId}
        ORDER BY p.created_at DESC
    </select>

    <!-- 프로젝트별 기술 스택 조회 -->
    <select id="selectStacksByProjectId" parameterType="int" resultType="com.sanaiclub.domain.project.dto.StackDto">
        SELECT 
            s.stack_id   AS stackId,
            s.stack_name AS stackName,
            s.category   AS category,
            ps.stack_level AS stackLevel,
            ps.stack_year  AS stackYear
        FROM project_stacks ps
        JOIN stacks s ON ps.stack_id = s.stack_id
        WHERE ps.project_id = #{projectId}
        ORDER BY s.category, s.stack_name
    </select>

    <!-- 프로젝트 상세 조회 -->
    <select id="findProjectById" parameterType="int" resultMap="projectDetailMap">
        SELECT 
            p.project_id,
            p.client_id,
            p.title,
            p.description,
            p.start_date,
            p.deadline_date,
            p.est_duration,
            p.duration_negotiable,
            p.budget,
            p.budget_negotiable,
            p.communicate_method,
            p.payment_method,
            p.change_policy,
            p.max_revision_count,
            p.project_status,
            p.is_public,
            p.created_at,
            p.updated_at,
            p.view_count,
            p.applicant_count,
            p.plan_url,
            p.file_size
        FROM projects p
        WHERE p.project_id = #{projectId}
    </select>

</mapper>
