<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanaiclub.portfolio.dao.StackOptionMapper">

    <select id="findByCategory" resultType="com.sanaiclub.project.model.dto.StackDTO">
        SELECT stack_id AS stackId,
               stack_name AS stackName,
               category
        FROM stacks
        WHERE category = #{category}
        ORDER BY stack_id ASC
    </select>

</mapper>
