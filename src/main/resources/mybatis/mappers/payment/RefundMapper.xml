<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanaiclub.payment.dao.RefundMapper">

    <resultMap id="RefundResultMap" type="com.sanaiclub.payment.model.vo.RefundVO">
        <id property="refundId" column="refund_id"/>
        <result property="paymentId" column="payment_id"/>
        <result property="contractId" column="contract_id"/>
        <result property="refundAmount" column="refund_amount"/>
        <result property="reason" column="reason"/>
        <result property="requestedBy" column="requested_by"/>
        <result property="refundStatus" column="refund_status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="impRefundUid" column="imp_refund_uid"/>
        <result property="refundedAt" column="refunded_at"/>
        <result property="failedReason" column="failed_reason"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 환불 정보 저장 -->
    <insert id="insertRefund" parameterType="com.sanaiclub.payment.model.vo.RefundVO"
            useGeneratedKeys="true" keyProperty="refundId">
        INSERT INTO refunds (
            payment_id, contract_id, refund_amount, reason,
            requested_by, refund_status, imp_refund_uid, refunded_at, failed_reason
        ) VALUES (
                     #{paymentId}, #{contractId}, #{refundAmount}, #{reason},
                     #{requestedBy}, #{refundStatus}, #{impRefundUid}, #{refundedAt}, #{failedReason}
                 )
    </insert>

    <!-- 환불 ID로 조회 -->
    <select id="selectRefundById" resultMap="RefundResultMap">
        SELECT * FROM refunds
        WHERE refund_id = #{refundId}
    </select>

    <!-- 계약 ID로 환불 목록 조회 -->
    <select id="selectRefundsByContractId" resultMap="RefundResultMap">
        SELECT * FROM refunds
        WHERE contract_id = #{contractId}
        ORDER BY created_at DESC
    </select>

    <!-- 결제 ID로 환불 목록 조회 -->
    <select id="selectRefundsByPaymentId" resultMap="RefundResultMap">
        SELECT * FROM refunds
        WHERE payment_id = #{paymentId}
        ORDER BY created_at DESC
    </select>

    <!-- 환불 상태 업데이트 -->
    <update id="updateRefundStatus">
        UPDATE refunds
        SET refund_status = #{refundStatus},
            updated_at = NOW()
        WHERE refund_id = #{refundId}
    </update>

    <!-- 환불 정보 전체 업데이트 -->
    <update id="updateRefund" parameterType="com.sanaiclub.payment.model.vo.RefundVO">
        UPDATE refunds
        SET refund_status = #{refundStatus},
            imp_refund_uid = #{impRefundUid},
            refunded_at = #{refundedAt},
            failed_reason = #{failedReason},
            updated_at = NOW()
        WHERE refund_id = #{refundId}
    </update>

</mapper>