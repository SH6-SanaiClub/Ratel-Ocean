<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanaiclub.payment.dao.PaymentMapper">

    <!-- ResultMap 정의 -->
    <resultMap id="PaymentResultMap" type="com.sanaiclub.payment.model.vo.PaymentVO">
        <id property="paymentId" column="payment_id"/>
        <result property="contractId" column="contract_id"/>
        <result property="impUid" column="imp_uid"/>
        <result property="merchantUid" column="merchant_uid"/>
        <result property="amount" column="amount"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="paymentStatus" column="payment_status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="paidAt" column="paid_at"/>
        <result property="failedReason" column="failed_reason"/>
        <result property="buyerName" column="buyer_name"/>
        <result property="buyerEmail" column="buyer_email"/>
        <result property="buyerTel" column="buyer_tel"/>
        <result property="pgProvider" column="pg_provider"/>
        <result property="pgTid" column="pg_tid"/>
        <result property="cardName" column="card_name"/>
        <result property="cardNumber" column="card_number"/>
        <result property="receiptUrl" column="receipt_url"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 결제 정보 저장 -->
    <insert id="insertPayment" parameterType="com.sanaiclub.payment.model.vo.PaymentVO"
            useGeneratedKeys="true" keyProperty="paymentId">
        INSERT INTO payments (
            contract_id, imp_uid, merchant_uid, amount, payment_method,
            payment_status, paid_at, failed_reason, buyer_name, buyer_email, buyer_tel,
            pg_provider, pg_tid, card_name, card_number, receipt_url
        ) VALUES (
                     #{contractId}, #{impUid}, #{merchantUid}, #{amount}, #{paymentMethod},
                     #{paymentStatus}, #{paidAt}, #{failedReason}, #{buyerName}, #{buyerEmail}, #{buyerTel},
                     #{pgProvider}, #{pgTid}, #{cardName}, #{cardNumber}, #{receiptUrl}
                 )
    </insert>

    <!-- 결제 ID로 조회 -->
    <select id="selectPaymentById" resultMap="PaymentResultMap">
        SELECT * FROM payments
        WHERE payment_id = #{paymentId}
    </select>

    <!-- 포트원 결제 고유번호로 조회 -->
    <select id="selectPaymentByImpUid" resultMap="PaymentResultMap">
        SELECT * FROM payments
        WHERE imp_uid = #{impUid}
    </select>

    <!-- 가맹점 주문번호로 조회 -->
    <select id="selectPaymentByMerchantUid" resultMap="PaymentResultMap">
        SELECT * FROM payments
        WHERE merchant_uid = #{merchantUid}
    </select>

    <!-- 계약 ID로 결제 목록 조회 -->
    <select id="selectPaymentsByContractId" resultMap="PaymentResultMap">
        SELECT * FROM payments
        WHERE contract_id = #{contractId}
        ORDER BY created_at DESC
    </select>

    <!-- 결제 상태 업데이트 -->
    <update id="updatePaymentStatus">
        UPDATE payments
        SET payment_status = #{paymentStatus},
            updated_at = NOW()
        WHERE payment_id = #{paymentId}
    </update>

    <!-- 결제 정보 전체 업데이트 -->
    <update id="updatePayment" parameterType="com.sanaiclub.payment.model.vo.PaymentVO">
        UPDATE payments
        SET payment_status = #{paymentStatus},
            paid_at = #{paidAt},
            failed_reason = #{failedReason},
            receipt_url = #{receiptUrl},
            updated_at = NOW()
        WHERE payment_id = #{paymentId}
    </update>

    <!-- 결제 삭제 -->
    <delete id="deletePayment">
        DELETE FROM payments
        WHERE payment_id = #{paymentId}
    </delete>

</mapper>