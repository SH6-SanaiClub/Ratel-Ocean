<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanaiclub.user.dao.FreelancerMyPageMapper">

    <!-- users 테이블 -> UserVO -->
    <resultMap id="userResultMap" type="com.sanaiclub.user.model.vo.UserVO">
        <id property="userId" column="user_id"/>

        <result property="loginId" column="login_id"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="refreshToken" column="refresh_token"/>

        <!-- enum 매핑: TypeHandler 설정돼있으면 아래 javaType 생략 가능 -->
        <result property="userType" column="user_type"
                javaType="com.sanaiclub.user.model.vo.UserType"/>
        <result property="status" column="status"
                javaType="com.sanaiclub.user.model.vo.UserStatus"/>

        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="birthDate" column="birth_date"/>
        <result property="profileImageUrl" column="profile_image_url"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectFreelancerProfile" parameterType="int" resultMap="userResultMap">
        SELECT
            user_id, login_id, email, password, refresh_token,
            user_type, status, name, phone, birth_date,
            profile_image_url, created_at, updated_at
        FROM users
        WHERE user_id = #{userId}
    </select>


    <!-- 내 정보 수정 -->
    <update id="updateUserInfo" parameterType="com.sanaiclub.user.model.vo.UserVO">
        UPDATE users
        SET
        phone = #{phone},
        updated_at = NOW()
        WHERE user_id = #{userId}
    </update>

    <!-- 비밀번호 확인 -->
    <select id="selectPassword" parameterType="int" resultType="String">
        SELECT password
        FROM users
        WHERE user_id = #{userId}
    </select>

    <!-- 비밀번호 변경: (권장) Map/Param 기반으로 받기 -->
    <update id="updatePassword" parameterType="map">
        UPDATE users
        SET password = #{newPassword},
            updated_at = NOW()
        WHERE user_id = #{userId}
    </update>

</mapper>
