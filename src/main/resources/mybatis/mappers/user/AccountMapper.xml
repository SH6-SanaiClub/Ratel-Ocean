<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanaiclub.user.dao.AccountMapper">

    <resultMap id="AccountResultMap" type="com.sanaiclub.user.model.vo.AccountVO">
        <id property="accountId" column="account_id"/>
        <result property="userId" column="user_id"/>
        <result property="bankName" column="bank_name"/>
        <result property="accountHolder" column="account_holder"/>
        <result property="accountNumber" column="account_number"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!--
        계좌 정보 등록
    -->
    <insert id="insertAccount" parameterType="com.sanaiclub.user.model.vo.AccountVO"
            useGeneratedKeys="true" keyProperty="accountId">
        INSERT INTO accounts (
            user_id,
            bank_name,
            account_number,
            account_holder
        ) VALUES (
                     #{userId},
                     #{bankName},
                     #{accountNumber},
                     #{accountHolder}
                 )
    </insert>

    <!--
        사용자 ID로 계좌 정보 조회
    -->
    <select id="findByUserId" resultMap="AccountResultMap">
        SELECT
            account_id,
            user_id,
            bank_name,
            account_number,
            account_holder,
            updated_at
        FROM accounts
        WHERE user_id = #{userId}
        ORDER BY updated_at DESC
            LIMIT 1
    </select>

    <!--
        계좌 정보 수정
    -->
    <update id="updateAccount">
        UPDATE accounts
        SET
            bank_name = #{bankName},
            account_number = #{accountNumber},
            account_holder = #{accountHolder},
            updated_at = CURRENT_TIMESTAMP
        WHERE account_id = #{accountId}
    </update>

    <!--
        계좌 정보 삭제
    -->
    <delete id="deleteAccount">
        DELETE FROM accounts
        WHERE account_id = #{accountId}
    </delete>

</mapper>