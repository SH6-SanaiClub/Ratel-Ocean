<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanaiclub.contract.dao.ApiTokenDao">

    <select id="findActiveTokenByServiceName"
            parameterType="string"
            resultType="string">
        SELECT CONCAT('Bearer ', api_token)
        FROM api_tokens
        WHERE service_name = #{serviceName}
          AND is_active = 1
            LIMIT 1
    </select>

</mapper>
