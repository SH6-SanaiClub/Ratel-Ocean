@charset "UTF-8";

/* ═══════════════════════════════════════════════════════════════════════
   프로젝트 등록 페이지 스타일시트
   ═══════════════════════════════════════════════════════════════════════
   
   [컬러 가이드 준수]
   - Dark Charcoal Gray: #2B2B2B (제목, 핵심 텍스트)
   - Medium Gray: #6F7272 (보조 텍스트, 비활성 요소)
   - Off White: #F1F6EE (배경 70-80%)
   - Mint Blue: #9AD9DB (Secondary Accent)
   - Deep Teal: #1F7A8C (Primary Action)
   - White: #FFFFFF (카드/패널 배경)
   
   [사용 규칙]
   - Accent Color는 전체 화면의 10% 이하
   - Primary Action (#1F7A8C): 메인 CTA 버튼, 선택된 상태
   - Secondary Accent (#9AD9DB): 보조 버튼, 링크
   - 한 화면에서 Accent Color는 1개만 강조
   
   ═══════════════════════════════════════════════════════════════════════ */

:root {
    /* Core Color Palette */
    --color-dark-charcoal: #2B2B2B;
    --color-medium-gray: #6F7272;
    --color-off-white: #F1F6EE;
    --color-mint-blue: #9AD9DB;
    --color-deep-teal: #1F7A8C;
    --color-white: #FFFFFF;
    
    /* Semantic Colors */
    --color-primary: var(--color-deep-teal);
    --color-primary-hover: #165b69;
    --color-secondary: var(--color-mint-blue);
    --color-text-primary: var(--color-dark-charcoal);
    --color-text-secondary: var(--color-medium-gray);
    --color-background: var(--color-off-white);
    --color-surface: var(--color-white);
    --color-border: #E0E0E0;
    --color-disabled: var(--color-medium-gray);
    
    /* Spacing */
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 1.5rem;
    --spacing-lg: 2rem;
    --spacing-xl: 3rem;
    
    /* Border Radius */
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;
    
    /* Shadows */
    --shadow-sm: 0 2px 4px rgba(43, 43, 43, 0.06);
    --shadow-md: 0 4px 12px rgba(43, 43, 43, 0.08);
    --shadow-lg: 0 8px 24px rgba(43, 43, 43, 0.12);
}

/* ═══════════════════════════════════════════════════════════════════════
   Base Styles
   ═══════════════════════════════════════════════════════════════════════ */

body {
    background-color: var(--color-background);
    font-family: 'Noto Sans KR', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.6;
}

/* ═══════════════════════════════════════════════════════════════════════
   Layout
   ═══════════════════════════════════════════════════════════════════════ */

.wrapper {
    max-width: 1200px;
    margin: var(--spacing-xl) auto;
    padding: 0 var(--spacing-md);
}

.content-area {
    max-width: 900px;
    margin: 0 auto;
}

/* ═══════════════════════════════════════════════════════════════════════
   Form Container
   ═══════════════════════════════════════════════════════════════════════ */

#projectForm {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
}

/* ═══════════════════════════════════════════════════════════════════════
   Step Sections
   ═══════════════════════════════════════════════════════════════════════ */

.step-section {
    display: none;
    animation: fadeIn 0.3s ease;
}

.step-section.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ─────────────────────────────────────────────────────────────────────
   Step Header
   ───────────────────────────────────────────────────────────────────── */

.step-header-group {
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-primary);
}

.step-desc-small {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xs);
    font-weight: 500;
}

.step-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
}

/* ═══════════════════════════════════════════════════════════════════════
   Form Groups
   ═══════════════════════════════════════════════════════════════════════ */

.form-group-styled {
    margin-bottom: var(--spacing-lg);
}

.form-group-styled:last-of-type {
    margin-bottom: var(--spacing-xl);
}

/* ─────────────────────────────────────────────────────────────────────
   Labels
   ───────────────────────────────────────────────────────────────────── */

.label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
}

.required {
    color: #D32F2F;
    margin-left: 4px;
    font-weight: 700;
}

.input-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-top: var(--spacing-xs);
    line-height: 1.5;
}

.reg-date {
    float: right;
    font-size: 13px;
    color: #999;
    margin-top: 5px;
}

.project-title {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.4;
    margin: 0;
    color: #222;
    word-break: keep-all;
}

/* 요약 정보 카드 */
.summary-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    margin-bottom: 40px;
}

.summary-top {
    padding: 30px 35px;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #eee;
}

.summary-item {
    display: flex;
    flex-direction: column;
}

.summary-label {
    font-size: 14px;
    color: #888;
    margin-bottom: 8px;
}

.summary-value {
    font-size: 18px;
    font-weight: 700;
    color: #333;
}

.summary-value.money {
    color: var(--primary);
    font-size: 22px;
}

.summary-bottom {
    background-color: var(--bg-gray);
    padding: 30px 35px;
}

.info-grid {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 15px 0;
    margin-bottom: 25px;
}

.info-label {
    font-size: 15px;
    color: #666;
    font-weight: 500;
}

.info-text {
    font-size: 15px;
    color: #333;
    font-weight: 600;
}

/* 스택 태그 */
.stack-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.tech-badge {
    display: inline-flex;
    align-items: center;
    background: #fff;
    border: 1px solid #ddd;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    color: #555;
}

.tech-badge i {
    margin-right: 6px;
    color: var(--primary);
}

.tech-badge.unknown {
    color: #888;
    background-color: #f0f0f0;
    border-color: #ddd;
}

/* 상세 내용 */
.section-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 20px;
    border-left: 4px solid var(--primary);
    padding-left: 12px;
    color: #222;
}

.description-box {
    font-size: 16px;
    line-height: 1.8;
    color: #444;
    white-space: pre-wrap;
    margin-bottom: 60px;
    min-height: 200px;
}

.meta-info-list {
    list-style: none;
    padding: 0;
    margin: 0 0 50px 0;
    border-top: 1px solid #eee;
}

.meta-info-list li {
    display: flex;
    padding: 18px 0;
    border-bottom: 1px solid #eee;
    font-size: 15px;
}

.meta-key {
    width: 160px;
    color: #888;
    font-weight: 500;
}

.meta-val {
    color: #333;
    font-weight: 600;
}

/* === 우측 사이드바 === */
.sidebar-area {
    width: 320px;
    flex-shrink: 0;
    position: sticky;
    top: 30px;
}

/* 지원 카드 */
.action-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    margin-bottom: 20px;
}

.btn-apply {
    display: block;
    width: 100%;
    background-color: var(--primary);
    color: #fff;
    text-align: center;
    padding: 16px 0;
    border-radius: 6px;
    font-size: 18px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: 0.2s;
    margin-bottom: 10px;
}

.btn-apply:hover {
    background-color: var(--primary-hover);
}

.btn-wish {
    display: block;
    width: 100%;
    background-color: #fff;
    color: #555;
    text-align: center;
    padding: 12px 0;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    border: 1px solid #ddd;
    cursor: pointer;
    transition: 0.2s;
}

.btn-wish:hover {
    background-color: #f9f9f9;
}

/* 찜하기 활성화 상태 */
.btn-wish.active {
    border-color: var(--primary);
    color: var(--primary);
    background-color: var(--primary-bg);
}

.btn-wish.active i {
    color: var(--primary);
}

.stats-row {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    gap: 15px;
    font-size: 13px;
    color: #888;
}

.stats-row span i {
    margin-right: 4px;
}

/* 클라이언트 카드 */
.client-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 25px;
}

.client-header {
    display: flex;
    align-items: center;
    margin-bottom: 15px;
}

.client-img {
    width: 50px;
    height: 50px;
    background-color: #eee;
    border-radius: 50%;
    margin-right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #aaa;
    font-size: 24px;
}

.client-info h4 {
    margin: 0 0 4px 0;
    font-size: 16px;
    color: #333;
}

.verified-badge {
    font-size: 12px;
    color: var(--primary);
    font-weight: 600;
}

.client-desc {
    font-size: 14px;
    color: #666;
    line-height: 1.5;
    margin-bottom: 20px;
    word-break: keep-all;
}

.project-counts {
    border-top: 1px solid #eee;
    padding-top: 15px;
}

.count-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-bottom: 8px;
    color: #555;
}

.count-row strong {
    color: #333;
}